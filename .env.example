# Backend settings (app/config.py). Export them in the shell or prefix a make target, e.g.:
#   USE_MOCKS=1 make demo
#   MOCK_MODULES=shade,exposure make dev

DATA_DIR=data/processed
SCENARIO_DIR=scenarios

# 1 = all modules are mocks (no data needed)
USE_MOCKS=0
# Mock only some modules: graph, shade, env, exposure
MOCK_MODULES=
# 1 = crash at startup when a real module fails, instead of falling back to its mock
STRICT_MODULES=0
WARMUP=1
COST_CACHE_SIZE=32
LOG_LEVEL=INFO

# Where the real implementations live ("module:attr"); change only if a role moves its code
GRAPH_FACTORY=app.graph.routing:RoutingGraph.load
SHADE_FACTORY=app.shade.model:ShadeModel.load
ENV_FACTORY=app.env.service:EnvironmentService
EXPOSURE_FN=app.env.exposure:compute_edge_exposure
DISCOMFORT_FN=app.env.exposure:discomfort
